# What matrix E converts A into triangular form EA=U? Multiply by E^-1 = L to factor A into LU

import numpy as np

# Define the matrix A
A = np.array([
    [1, 3, 0],
    [2, 4, 0],
    [2, 0, 1]
])

# Perform LU decomposition using scipy
from scipy.linalg import lu

P, L, U = lu(A)

# Display the results
print("Matrix A:")
print(A)
print("\nPermutation Matrix P:")
print(P)
print("\nLower Triangular Matrix L:")
print(L)
print("\nUpper Triangular Matrix U:")
print(U)

# Verify the result by checking if A = P @ L @ U
A_reconstructed = P @ L @ U
print("\nReconstructed Matrix A from P, L, and U:")
print(A_reconstructed)
print("\nVerification (A == P @ L @ U):")
print(np.allclose(A, A_reconstructed))

